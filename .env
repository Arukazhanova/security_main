SERVER_PORT=8081

DB_URL=jdbc:h2:file:./data/securitysite_db;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH
DB_USERNAME=postgres
DB_PASSWORD=qwerty

JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

JWT_SECRET=change-this-dev-secret-to-a-long-random-string-32-plus-chars
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_DAYS=7

APP_BASE_URL=http://localhost:5174

LOCAL_MAILBOX_ENABLED=true
EXPOSE_AUTH_LINKS_IN_RESPONSE=true

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=Admin12345
ADMIN_CREATE_ON_STARTUP=true